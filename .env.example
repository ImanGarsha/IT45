# Copy to .env (same folder) and fill in. .env is git-ignored. Restart IT45 after editing.
# Every key here is a TESTNET or trade-only key. Never put a main wallet's private key here.
# Step-by-step setup for each venue: docs/03_keys.md

# Hyperliquid testnet: agent (API) wallet approved by your account
IT45_HL_AGENT_KEY=
IT45_HL_ACCOUNT_ADDRESS=

# Bulk testnet: run scripts\bulk_testnet_wallet.py to create and fund this automatically
IT45_BULK_SIGNER_KEY=
IT45_BULK_ACCOUNT=

# Meridian testnet: linked signer; run scripts\meridian_link_signer.py to create it
IT45_MERIDIAN_SIGNER_KEY=
IT45_MERIDIAN_ACCOUNT=
IT45_MERIDIAN_SUBACCOUNT=primary
